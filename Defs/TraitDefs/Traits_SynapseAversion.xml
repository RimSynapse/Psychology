<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Skill-driven aversion (RimSynapse trait engine). A pawn who fixates on one passion and starves
    another grows a graduated DISTASTE for the affected work: reluctant -> averse, expressed as a
    growing skill penalty (the "slow learner / rusty" effect) rather than a hard block. Only the rarest,
    most sustained crash-out reaches the separate INCAPABLE trait, which actually disables the work type.
    All commonality 0 (engine-assigned only). Applied via SynapsePsychology.ApplyTraitStep/ApplyTraitDirective;
    removal routes through TraitSet.RemoveTrait so the skill penalty / work-disable is undone cleanly.
  -->

  <!-- ============================ Graduated distaste spectra ============================ -->

  <TraitDef>
    <defName>Synapse_Aversion_Intellectual</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>reluctant thinker</label>
        <description>{PAWN_nameDef} has soured on intellectual work and drags {PAWN_objective}self to the research bench.</description>
        <statFactors><ResearchSpeed>0.85</ResearchSpeed></statFactors>
      </li>
      <li>
        <degree>2</degree>
        <label>research-averse</label>
        <description>{PAWN_nameDef} has come to resent intellectual work; {PAWN_possessive} mind balks at it and the work crawls.</description>
        <statFactors><ResearchSpeed>0.6</ResearchSpeed></statFactors>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
    <defName>Synapse_Aversion_Plants</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>reluctant grower</label>
        <description>{PAWN_nameDef} is tiring of the fields and tends them with waning care.</description>
        <statFactors><PlantWorkSpeed>0.85</PlantWorkSpeed></statFactors>
      </li>
      <li>
        <degree>2</degree>
        <label>growing-averse</label>
        <description>{PAWN_nameDef} has grown to resent working the soil, and labors at it slowly and grudgingly.</description>
        <statFactors><PlantWorkSpeed>0.6</PlantWorkSpeed></statFactors>
      </li>
    </degreeDatas>
  </TraitDef>

