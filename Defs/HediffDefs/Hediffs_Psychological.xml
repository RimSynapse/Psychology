<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Treatable psychological conditions (#17 redesign). Unlike vanilla illnesses these do NOT resolve
    on their own — no immunity, no natural severity decline. They persist until therapy drives severity
    to zero (SynapseTherapyConditions.Treat), and while untreated the pawn falls into the linked mental
    state more often, scaled by severity (SynapseTherapyConditions.TickChaos). Severity 0..1; the stages
    are display bands. Not medically tendable — therapy in the patient's own bedroom is the treatment.
  -->

  <HediffDef>
    <defName>Synapse_Hediff_Trauma</defName>
    <label>trauma</label>
    <description>A deep, unresolved traumatic wound. Left untreated it intrudes without warning — the mind is dragged back into the moment. Talking it through, patiently and in private, is the only thing that lastingly helps.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <defaultLabelColor>(0.72, 0.5, 0.82)</defaultLabelColor>
    <stages>
      <li><label>mild</label><minSeverity>0</minSeverity></li>
      <li><label>moderate</label><minSeverity>0.4</minSeverity></li>
      <li><label>severe</label><minSeverity>0.75</minSeverity></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Synapse_Hediff_Depression</defName>
    <label>depression</label>
    <description>A persistent, heavy low that colours everything. It does not lift by itself; without help the person withdraws and gives up more and more. Steady, private counselling slowly loosens its grip.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <defaultLabelColor>(0.45, 0.55, 0.72)</defaultLabelColor>
    <stages>
      <li><label>mild</label><minSeverity>0</minSeverity></li>
      <li><label>moderate</label><minSeverity>0.4</minSeverity></li>
      <li><label>severe</label><minSeverity>0.75</minSeverity></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Synapse_Hediff_Anxiety</defName>
    <label>anxiety disorder</label>
    <description>A chronic, jangling dread. Untreated it boils over into panic at the worst moments. Being talked down and reassured, again and again in a safe place, is what eventually settles it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <defaultLabelColor>(0.85, 0.72, 0.42)</defaultLabelColor>
    <stages>
      <li><label>mild</label><minSeverity>0</minSeverity></li>
      <li><label>moderate</label><minSeverity>0.4</minSeverity></li>
      <li><label>severe</label><minSeverity>0.75</minSeverity></li>
    </stages>
  </HediffDef>

</Defs>
